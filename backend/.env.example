# Copy to backend/.env and fill in. Every setting is documented in tally/config.py.

# --- Postgres (required) ---------------------------------------------------
# Local install:  postgresql://postgres:YOURPASSWORD@localhost:5432/tally
# Neon (free):    postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/tally?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tally

# --- Queue -------------------------------------------------------------------
# or: redis (needs REDIS_URL)
QUEUE_BACKEND=postgres
REDIS_URL=redis://localhost:6379/0

# --- LLM extraction ------------------------------------------------------------
# rules = offline regex baseline (no key needed). For real extraction pick one:
# gemini | groq | openrouter | rules
LLM_PROVIDER=rules
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# keep under your provider's free-tier limit
LLM_REQUESTS_PER_MINUTE=8

# --- Market data ---------------------------------------------------------------
# or: synthetic (offline, deterministic fake prices)
MARKET_DATA_PROVIDER=yfinance

# --- Run everything in one process (handy locally and on a free Render instance) ---
EMBEDDED_WORKER=true
EMBEDDED_SCHEDULER=true
SCORING_INTERVAL_MINUTES=360

# --- Sources (optional; each new post costs one LLM call) -------------------------
# Polled automatically every SOURCE_POLL_INTERVAL_MINUTES. You can also pull any source on demand
# from the System tab (Sources card) or with `python -m tally poll --subreddit/--stocktwits/--rss`.
# Subreddits, comma-separated (read via Reddit RSS), e.g. stocks,ValueInvesting
REDDIT_SUBREDDITS=
# Substack publications (the <name> in <name>.substack.com), e.g. stocksunderrocks,stockpicking
SUBSTACK_PUBLICATIONS=
# StockTwits streams: symbols or "trending", e.g. trending,NVDA (currently blocked by bot protection)
STOCKTWITS_STREAMS=
# RSS/Atom feeds (https), e.g. https://stocksunderrocks.substack.com/feed
RSS_FEEDS=

# --- API -------------------------------------------------------------------------
ADMIN_TOKEN=change-me-to-something-long
CORS_ORIGINS=http://localhost:5173
